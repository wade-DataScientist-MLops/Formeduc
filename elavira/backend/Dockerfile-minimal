FROM python:3.11-slim

WORKDIR /app

# Installer seulement les dépendances essentielles
RUN pip install --no-cache-dir fastapi uvicorn sqlalchemy psycopg2-binary pydantic

# Copier seulement les fichiers nécessaires
COPY main.py .
COPY api/ ./api/
COPY db/ ./db/
COPY core/ ./core/

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]